# Authoritative list of every environment variable any just recipe reads.
# Copy to .env and fill in. `just check` fails if a recipe reads a variable not listed here.
# Never commit .env. Never paste values into chat or into a file that is tracked by git.

# --- Cloudflare R2 (shared, non-secret) ---------------------------------------
# From the R2 overview page of the Cloudflare account. The bucket is in the EU
# jurisdiction, so the endpoint contains ".eu.".
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
R2_BUCKET=semi-sys-research-data

# --- Your read key (team password manager: "team-read", Object Read only) -----
# Used by catalog views, search, experiments and dashboards.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Your scratch key (team password manager: "<handle>-scratch", Read & Write)
# Used only when code writes to scratch/<handle>/. R2_HANDLE is your GitHub handle.
R2_HANDLE=
R2_SCRATCH_ACCESS_KEY_ID=
R2_SCRATCH_SECRET_ACCESS_KEY=

# --- Role (optional) ------------------------------------------------------------
# Leave empty on a laptop. CI sets QUANT_ROLE=ingest (may write raw/) or
# QUANT_ROLE=promote (may write curated/). Anything else may write scratch/<handle>/ only.
QUANT_ROLE=

# --- Vendors (optional) ---------------------------------------------------------
# Paid data vendor key. Empty until a vendor is added (see knowledge/context/vendors.md).
VENDOR_API_KEY=

# --- Backups (optional, CI only) ------------------------------------------------
# Backblaze B2 application key for scripts/backup.sh. backup.yml skips when empty.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# --- Retrieval (optional) -------------------------------------------------------
# Name of an embedding model for `just embed`. Unset in v1; `just embed` errors until set.
EMBEDDING_MODEL=

# --- GitHub (optional) ----------------------------------------------------------
# Token for `gh` when a skill opens issues or PRs from inside the devcontainer.
# In Actions this is provided automatically.
GH_TOKEN=
