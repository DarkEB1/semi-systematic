{
  "name": "semi-systematic",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "workspaceFolder": "/workspaces/semi-systematic",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/semi-systematic,type=bind",
  "mounts": [
    "source=semi-systematic-venv,target=/opt/venv,type=volume",
    "source=semi-systematic-uv-cache,target=/root/.cache/uv,type=volume"
  ],
  "containerEnv": { "UV_PROJECT_ENVIRONMENT": "/opt/venv" },
  "postCreateCommand": "just setup",
  "forwardPorts": [2718],
  "portsAttributes": { "2718": { "label": "dashboard hub" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "marimo-team.vscode-marimo"],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
